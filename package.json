{
  "name": "tradenote-obsidian",
  "version": "0.1.1",
  "description": "本地优先的交易复盘插件，支持日历记录、历史检索、图片附件和可选的 AI 日报与周报分析。",
  "private": true,
  "scripts": {
    "test": "node scripts/regression.cjs",
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "release:files": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2"
  }
}
