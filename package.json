{
  "name": "tradenote-obsidian",
  "version": "0.1.4",
  "description": "本地优先的交易复盘插件，支持日历记录、历史检索、图片附件和可选的 AI 日报与周报分析。",
  "private": true,
  "scripts": {
    "test": "node scripts/regression.cjs",
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "check": "tsc --noEmit",
    "release:files": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "lint": "eslint src --max-warnings 0 && node scripts/review-audit.cjs",
    "package": "pnpm build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  }
}
